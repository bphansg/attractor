{
  "name": "@attractor/llm",
  "version": "0.1.0",
  "description": "Unified LLM client across OpenAI, Anthropic, and Gemini",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",

// Secure PR review workflow with human approval gates
// Demonstrates: plan -> implement -> test -> human gate -> ship or fix loop
digraph secure_pr_review {
  goal = "Implement a feature with security review before merging"

  start [shape=Mdiamond, label="Start"]
  
  plan [shape=box, label="Plan Changes", 
        prompt="Create a detailed implementation plan for $goal"]
  
  implement [shape=box, label="Implement", 
             prompt="Write the code changes according to the plan"]
  
  test [shape=box, label="Run Tests", 
        prompt="Execute linting, type-checking, and test suite"]
  
  test_gate [shape=diamond, label="Tests Pass?"]
  
  security_review [shape=hexagon, label="Security Review"]
  
  ship [shape=box, label="Merge PR", 
        prompt="Apply the approved changes to main branch"]
  
  fix [shape=box, label="Address Feedback", 
       prompt="Incorporate the security feedback and update the implementation"]
  
  done [shape=Msquare, label="Done"]

  // Main flow
  start -> plan -> implement -> test -> test_gate
  
  // Test gate branches
  test_gate -> security_review [label="pass", condition="outcome=success", weight=2]
  test_gate -> plan [label="fail", condition="outcome!=success"]
  
  // Human security review gate
  security_review -> ship [label="approved", condition="preferred_label=approved"]
  security_review -> fix [label="needs_changes", condition="preferred_label=changes_requested"]
  
  // Fix loop back to human review
  fix -> test
  
  ship -> done
}
